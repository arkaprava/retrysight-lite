# Local secrets — leave unset to auto-generate into the data dir on first run:
#   data/admin-token
#   data/agent-api-key
# RETRYSIGHT_ADMIN_TOKEN=
# AGENT_API_KEY=

RETRYSIGHT_HOST=127.0.0.1
RETRYSIGHT_PORT=18081
RETRYSIGHT_PUBLIC_URL=http://127.0.0.1:18081

# In-process collectors (default on)
# RETRYSIGHT_COLLECTORS=1
# RETRYSIGHT_CURSOR=1
# RETRYSIGHT_CLAUDE=1
# RETRYSIGHT_CURSOR_PATHS=
# RETRYSIGHT_CLAUDE_PATHS=

# GraphQL introspection / GraphiQL (off by default)
# RETRYSIGHT_GRAPHQL_DEV=1

# Bind LAN intentionally (default is loopback only):
# RETRYSIGHT_HOST=0.0.0.0
