# Local secrets — leave unset to auto-generate into the data dir on first run:
#   data/admin-token
#   data/agent-api-key
# RETRYSITELITE_ADMIN_TOKEN=
# AGENT_API_KEY=

RETRYSITELITE_HOST=127.0.0.1
RETRYSITELITE_PORT=18081
RETRYSITELITE_PUBLIC_URL=http://127.0.0.1:18081

# In-process collectors (default on)
# RETRYSITELITE_COLLECTORS=1
# RETRYSITELITE_CURSOR=1
# RETRYSITELITE_CLAUDE=1
# RETRYSITELITE_CURSOR_PATHS=
# RETRYSITELITE_CLAUDE_PATHS=

# GraphQL introspection / GraphiQL (off by default)
# RETRYSITELITE_GRAPHQL_DEV=1

# Bind LAN intentionally (default is loopback only):
# RETRYSITELITE_HOST=0.0.0.0
